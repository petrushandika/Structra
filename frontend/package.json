{
  "name": "structra-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun next lint",
    "type-check": "bun tsc --noEmit",
    "format": "bun prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "bun prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
